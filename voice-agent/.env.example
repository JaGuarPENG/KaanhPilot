# First run: deterministic demo, no API key needed.
LLM_PROVIDER=mock
# Explicit opt-in to the existing product-card backend (see README).
EXECUTOR_PROVIDER=mock
TASKRUNNER_BASE_URL=http://127.0.0.1:9090
TASKRUNNER_TIMEOUT_SECONDS=8
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_THINKING=disabled
MODEL_TIMEOUT_SECONDS=60
MAX_COMPLETION_TOKENS=4096

# Optional MiniMax text-to-speech. Reuses MINIMAX_API_KEY and, by default, MINIMAX_BASE_URL.
TTS_PROVIDER=disabled
# Stream PCM to the local speaker; false restores full WAV synthesis before playback.
TTS_STREAMING=true
TTS_BASE_URL=
TTS_MODEL=speech-2.8-turbo
TTS_VOICE_ID="Chinese (Mandarin)_Crisp_Girl"
TTS_LANGUAGE_BOOST=Chinese
TTS_SPEED=1.0
TTS_VOLUME=1.0
TTS_PITCH=0
TTS_SAMPLE_RATE=32000
TTS_BITRATE=128000
TTS_TIMEOUT_SECONDS=60
TTS_MAX_AUDIO_BYTES=10485760

# STT provider: disabled / whisper (local) / xfyun (cloud WebAPI)
ASR_PROVIDER=disabled
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=zh

# XFYun Voice Dictation WebAPI credentials from the same enabled application.
# Required only when ASR_PROVIDER=xfyun. Never commit a real .env file.
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
XFYUN_ASR_URL=wss://iat-api.xfyun.cn/v2/iat
XFYUN_ASR_LANGUAGE=zh_cn
XFYUN_ASR_DOMAIN=iat
XFYUN_ASR_ACCENT=mandarin
XFYUN_ASR_DYNAMIC_CORRECTION=true
# Continuous listener only: send PCM while recording; false keeps whole-recording mode.
XFYUN_ASR_STREAMING=true
XFYUN_ASR_TIMEOUT_SECONDS=75
MAX_AUDIO_BYTES=10485760
MAX_AUDIO_SECONDS=60

SCENE=home_assistant
MAX_SESSIONS=200
SESSION_TTL_SECONDS=3600

# Continuous microphone listener: pip install -e '.[voice]'
# Also set ASR_PROVIDER=whisper or xfyun above, then run: voice-agent-listen
WAKE_PROVIDER=asr
# Use xfyun for local AIKit wake; reuses XFYUN_APP_ID/API_KEY/API_SECRET.
# Requires the offline wake ability on that application and Win64 SDK resources.
XFYUN_WAKE_SDK_DIR=voice_agent/resources/xfyun_wake
XFYUN_WAKE_KEYWORD_PATH=voice_agent/resources/xfyun_wake/keyword.txt
XFYUN_WAKE_WORK_DIR=logs/xfyun_wake
XFYUN_WAKE_THRESHOLD="0 0:999"
WAKE_PHRASE=你好小助手
WAKE_TIMEOUT_SECONDS=8
VAD_AGGRESSIVENESS=2
AUDIO_FRAME_MS=30
AUDIO_PRE_ROLL_MS=300
AUDIO_START_SPEECH_MS=60
AUDIO_MIN_SPEECH_MS=240
AUDIO_END_SILENCE_MS=800
AUDIO_MAX_UTTERANCE_MS=15000

# Optional dedicated keyword engine: pip install -e '.[voice,porcupine]'
# Supply platform-specific .ppn and matching language .pv files yourself.
PORCUPINE_ACCESS_KEY=
PORCUPINE_KEYWORD_PATH=
PORCUPINE_MODEL_PATH=
WAKE_SENSITIVITY=0.5

# Persistent JSONL audit log (paths are relative to the current working directory)
LOG_ENABLED=true
LOG_FILE=logs/agent.jsonl
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_INCLUDE_TEXT=true
